{
  "name": "explorer",
  "version": "3.8.1",
  "private": true,
  "scripts": {
    "dev:anvil-catalog": "./scripts/dev.sh anvil-catalog dev && ./scripts/set-version.sh dev && next dev --webpack",
    "build-dev:anvil-catalog": "scripts/common-build.sh anvil-catalog dev && ./scripts/set-version.sh && next build --webpack && npm run postbuild",
    "build-prod:anvil-catalog": "./scripts/common-build.sh anvil-catalog prod && ./scripts/set-version.sh && next build --webpack && npm run postbuild",
    "dev:lungmap": "./scripts/dev.sh lungmap dev && ./scripts/set-version.sh dev && next dev --webpack",
    "build-dev:lungmap": "./scripts/common-build.sh lungmap dev && ./scripts/set-version.sh && next build --webpack && npm run postbuild",
    "build-prod:lungmap": "./scripts/common-build.sh lungmap prod && ./scripts/set-version.sh && next build --webpack && npm run postbuild",
    "dev:anvil-cmg": "./scripts/dev.sh anvil-cmg dev && ./scripts/set-version.sh dev && next dev --webpack",
    "build:anvil-cmg": "./scripts/build.sh anvil-cmg && ./scripts/set-version.sh && next build --webpack && npm run postbuild",
    "build-cc-dev:anvil-cmg": "./scripts/common-build.sh anvil-cmg cc-dev && ./scripts/set-version.sh && next build --webpack && npm run postbuild",
    "dev:hca-dcp": "./scripts/dev.sh hca-dcp ma-dev && ./scripts/set-version.sh dev && next dev --webpack",
    "build-ma-dev:hca-dcp": "./scripts/common-build.sh hca-dcp ma-dev && ./scripts/set-version.sh && next build --webpack && npm run postbuild",
    "build-ma-prod:hca-dcp": "./scripts/common-build.sh hca-dcp ma-prod && ./scripts/set-version.sh && next build --webpack && npm run postbuild",
    "postbuild": "next-sitemap --config next-sitemap.config.mjs",
    "start": "npx serve out",
    "lint": "eslint .",
    "check-format": "prettier --check .",
    "lint:python": "uv run --directory analytics --only-dev --locked ruff check .",
    "check-format:python": "uv run --directory analytics --only-dev --locked ruff format --check .",
    "format:python": "uv run --directory analytics --only-dev --locked ruff format .",
    "prepare": "husky",
    "test": "jest --watch",
    "test:e2e": "playwright test",
    "get-cellxgene-projects-hca": "esrun ./site-config/hca-dcp/ma-dev/scripts/get-cellxgene-projects.ts ",
    "test:anvil-cmg": "playwright test -c playwright_anvil.config.ts --trace retain-on-failure",
    "test:anvil-catalog": "playwright test -c playwright_anvil-catalog.config.ts --trace retain-on-failure",
    "check-system-status:anvil-cmg": "esrun e2e/anvil/anvil-check-system-status.ts",
    "refresh-diagnosis-terms:anvil-cmg": "esrun scripts/lookup-diagnosis-terms.ts"
  },
  "dependencies": {
    "@databiosphere/findable-ui": "^63.0.0",
    "@emotion/react": "^11",
    "@emotion/server": "^11",
    "@emotion/styled": "^11",
    "@mdx-js/loader": "^3",
    "@mdx-js/react": "^3",
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "@mui/material-nextjs": "^9",
    "@next/mdx": "^16.4.6",
    "@observablehq/plot": "^0",
    "@tanstack/match-sorter-utils": "^9",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-table": "^9",
    "@tanstack/react-virtual": "^3",
    "@types/fhir": "^0.0.44",
    "copy-to-clipboard": "4",
    "csv-parse": "^7.0.3",
    "gray-matter": "^4",
    "jwt-decode": "^4.0.0",
    "ky": "^2.2.0",
    "match-sorter": "^8.3.1",
    "next": "^16.4.6",
    "next-mdx-remote": "^6",
    "next-sitemap": "^4.2.3",
    "react": "^19",
    "react-dom": "^19",
    "react-gtm-module": "2",
    "react-idle-timer": "^5",
    "react-window": "2",
    "rehype-raw": "^7",
    "rehype-react": "^8",
    "rehype-sanitize": "^6",
    "remark-gfm": "^4",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "slugify": "^1",
    "unified": "^11",
    "uuid": "14",
    "yup": "^1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@digitak/esrun": "^3.2.26",
    "@eslint-community/eslint-plugin-eslint-comments": "^4",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^10",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-gtm-module": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "babel-loader": "^10.1.1",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65",
    "eslint-plugin-perfectionist": "^5",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-sonarjs": "^4",
    "eslint-plugin-sort-destructure-keys": "^3",
    "got": "^16.2.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2",
    "url-loader": "^4.1.1"
  },
  "engines": {
    "node": "22.13.0"
  },
  "overrides": {
    "eslint-plugin-sonarjs@^3": {
      "minimatch": "^10.2.3"
    }
  }
}
